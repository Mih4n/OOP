<Window x:Class="Second.Wpf.Eight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Second.Wpf.Eight.ViewModels"
        Title="Мониторинг склада" Height="450" Width="600"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" ItemsSource="{Binding Parts}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="False" Margin="0,0,0,10">
            
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDeficient}" Value="True">
                            <Setter Property="Background" Value="#FFCDD2"/> <!-- Светло-красный цвет -->
                            <Setter Property="ToolTip" Value="Внимание: позиция в дефиците!"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="В наличии" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="Мин. порог" Binding="{Binding MinThreshold, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="1" Header="Добавление новой позиции" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Text="Название:" Margin="2"/>
                <TextBlock Grid.Column="1" Text="Кол-во:" Margin="2"/>
                <TextBlock Grid.Column="2" Text="Порог:" Margin="2"/>

                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding NewMinThreshold, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

                <Button Grid.Row="1" Grid.Column="3" Content="Добавить" Command="{Binding AddPartCommand}" Margin="5,2,2,2"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>